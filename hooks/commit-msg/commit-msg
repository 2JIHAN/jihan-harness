#!/usr/bin/env node
// Git commit-msg hook — Conventional Commits & AI signature gate
//
// Responsibilities:
// 1. Immediately reject AI signatures/trailers (🤖, Co-authored-by, Generated with, etc.)
// 2. Enforce Conventional Commits (<type>(<scope>): <summary>)
// 3. Enforce 72-character limit and forbid trailing periods

const fs = require('fs');

const msgFile = process.argv[2];
if (!msgFile || !fs.existsSync(msgFile)) process.exit(0);

const rawMsg = fs.readFileSync(msgFile, 'utf8');
const lines = rawMsg
  .split('\n')
  .map((l) => l.trimEnd())
  .filter((l) => !l.startsWith('#')); // Exclude comments

if (lines.length === 0 || !lines[0].trim()) {
  console.error('\n[commit-msg rejected] Commit message is empty.\n');
  process.exit(1);
}

const firstLine = lines[0].trim();

// 1. Allow merge, tag, and temporary commit exceptions
if (/^(Merge branch|Merge pull request|Revert |fixup!|squash!)/i.test(firstLine)) {
  process.exit(0);
}

// 2. Block AI signatures and generated trailers
const AI_SIGNATURE_PATTERNS = [
  /🤖/i,
  /Co-Authored-By:/i,
  /Generated with/i,
  /Generated by/i,
  /Created with Claude/i,
  /Created with Antigravity/i,
  /noreply@anthropic\.com/i,
  /noreply@google\.com/i,
];

for (const pattern of AI_SIGNATURE_PATTERNS) {
  if (pattern.test(rawMsg)) {
    console.error('\n[commit-msg rejected] AI signature or generated trailer detected:');
    console.error(`  - Matched pattern: ${pattern}`);
    console.error('  - Rule: Write commit messages like a human engineer without AI signatures or trailers.\n');
    process.exit(1);
  }
}

// 3. Enforce Conventional Commits format
const CONVENTIONAL_REGEX = /^(feat|fix|refactor|perf|docs|test|chore|build|ci|style|revert)(\([a-z0-9-_/.]+\))?: [^A-Z\s].+$/;

if (!CONVENTIONAL_REGEX.test(firstLine)) {
  console.error('\n[commit-msg rejected] Commit message must follow Conventional Commits format:');
  console.error(`  - Received: "${firstLine}"`);
  console.error('  - Valid format: <type>(<scope>): <lowercase summary>');
  console.error('  - Supported types: feat, fix, refactor, perf, docs, test, chore, build, ci, style, revert');
  console.error('  - Example: feat(aside): add vision interaction module\n');
  process.exit(1);
}

// 4. Forbid trailing period on the first line
if (firstLine.endsWith('.')) {
  console.error('\n[commit-msg rejected] First line of commit message must not end with a period (.).\n');
  process.exit(1);
}

// 5. Enforce 72-character limit on the first line
if (firstLine.length > 72) {
  console.error(`\n[commit-msg rejected] First line must be 72 characters or fewer. (Current: ${firstLine.length})\n`);
  process.exit(1);
}

process.exit(0);
